{
    "name": "ide/pest-suite",
    "description": "A monorepo package tested with Pest",
    "type": "library",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
